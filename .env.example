# Database connection (PostgreSQL)
# Local: postgresql://USER:***@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telebot_analytics?schema=public"

# JWT configuration
JWT_SECRET="replace-this-with-a-strong-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000"
FRONTEND_PORT=3001

# Telegram Bot API (for webhook verification)
TELEGRAM_BOT_TOKEN=""

# Stripe (billing - placeholder)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""